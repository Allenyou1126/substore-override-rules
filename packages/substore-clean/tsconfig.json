{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        /* 测试文件会读产物文本（fs / zlib / import.meta.url），需要 Node 类型；
       全局 URL 与 import.meta.url 需要 DOM lib。
       `@types/node` 也写在本包 devDependencies 里：`types` 靠向上查找 node_modules 才能
       命中根上的那份，编辑器语言服务不一定会那样找，声明在本地才稳。
       这里只为类型检查，不影响产物：tsdown 的 platform 是 'neutral'，不注入任何 Node/DOM 假设。 */
        "types": ["node"],
        "lib": ["ES2022", "DOM"],

        /* 入口文件是本包唯一的源码，且被刻意写成「由 Sub-Store 在运行时取用的顶层函数」：
       `operator` 在源码里没有任何调用点。TS 会报 TS6133，而它无法在单行抑制 ——
       `@ts-expect-error` 与 oxlint 的 `// oxlint-disable-next-line` 都要求自己是紧邻上一行，
       不能共存。因此这里关闭未使用检查，改由 .oxlintrc.json 的 override 对其它文件生效，
       并由 test/artifact.test.ts（`pnpm test`，产物由 pretest 先构建）守住产物形状。 */
        "noUnusedLocals": false
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "tsdown.config.ts"]
}

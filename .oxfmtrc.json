{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "insertFinalNewline": true,
    "sortImports": {},
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "pnpm-lock.yaml",
        "package.json",
        "pnpm-workspace.yaml",
        "AGENTS.md",
        "README.md",
        "LICENSE"
    ]
}
